# Included at http scope by sites-enabled. No changes to default vhosts.
geo $realip_remote_addr $ryuksign_peer {
    default 0;
    100.64.0.0/10 1;
    fd7a:115c:a1e0::/48 1;
    # The host routing to itself is not a tailnet peer (longest prefix wins).
    100.98.158.112/32 0;
    fd7a:115c:a1e0::8701:9e90/128 0;
}
map $server_addr $ryuksign_interface {
    default 0;
    100.98.158.112 1;
    fd7a:115c:a1e0::8701:9e90 1;
}
limit_req_zone $binary_remote_addr zone=ryuksign_rate:1m rate=6r/m;
limit_conn_zone $server_name zone=ryuksign_connections:1m;

server {
    listen 80;
    listen [::]:80;
    server_name sign.rootios.com;
    access_log off;
    error_log /dev/null;
    return 403;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sign.rootios.com;
    ssl_certificate /etc/letsencrypt/live/rootios.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rootios.com/privkey.pem;
    access_log off;
    error_log /dev/null;
    default_type application/json;

    if ($ryuksign_peer = 0) { return 403 '{"error":"forbidden"}'; }
    if ($ryuksign_interface = 0) { return 403 '{"error":"forbidden"}'; }
    client_max_body_size 2m;
    client_body_buffer_size 2049k;
    client_body_timeout 10s;
    send_timeout 20s;
    limit_conn ryuksign_connections 16;
    limit_conn_status 429;
    limit_req_status 429;
    error_page 429 = @ryuksign_busy;
    error_page 413 = @ryuksign_large;
    error_page 502 503 504 = @ryuksign_unavailable;
    location @ryuksign_busy { return 429 '{"error":"rate_limited"}'; }
    location @ryuksign_large { return 413 '{"error":"bad_request"}'; }
    location @ryuksign_unavailable { return 503 '{"error":"unavailable"}'; }

    proxy_http_version 1.1;
    proxy_set_header Connection close;
    include /etc/ryuksign-update/proxy-header;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 120s;
    proxy_send_timeout 15s;
    proxy_connect_timeout 2s;
    proxy_next_upstream off;

    location = /ryuksign/sign {
        if ($request_method != POST) { return 405 '{"error":"bad_request"}'; }
        if ($http_content_encoding != "") { return 400 '{"error":"bad_request"}'; }
        if ($http_content_length = "") { return 411 '{"error":"bad_request"}'; }
        limit_req zone=ryuksign_rate burst=11 nodelay;
        proxy_pass http://127.0.0.1:18573;
    }
    location ~ "^/install/[A-Za-z0-9_-]{43}/(manifest\.plist|signed\.ipa)$" {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_pass http://127.0.0.1:18573;
    }
    location / { return 404; }
}
